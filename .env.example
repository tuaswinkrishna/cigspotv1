# Local PostGIS and Redis: docker compose up -d
DATABASE_URL=postgresql://cigspot:cigspot_dev_only@127.0.0.1:5433/cigspot
REDIS_URL=redis://127.0.0.1:6379
API_PORT=4000
NEXT_APP_ORIGIN=http://localhost:3000
CIGSPOT_API_ORIGIN=http://127.0.0.1:4000

# Public browser map token. If empty, the map uses the OpenFreeMap light style.
MAPBOX_ACCESS_TOKEN=

# R2 is optional for local development. Without these settings, uploads go to ./uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cigspot

# Replace this before exposing the API publicly.
COMMENT_HASH_SECRET=local-development-change-me
